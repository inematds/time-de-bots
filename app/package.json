{
  "name": "time-de-bots",
  "productName": "Time de Bots",
  "version": "0.1.0",
  "private": true,
  "description": "Independent desktop assistants with local memory, scheduled tasks and optional connected apps",
  "type": "module",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "test:desktop": "node test/community-desktop.mjs",
    "setup:assets": "node scripts/setup-assets.mjs",
    "verify:public": "node scripts/verify-public.mjs",
    "package:mac": "node scripts/package.mjs",
    "check": "npm run verify:public && npm test"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.65.0",
    "electron": "42.11.16"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@composio/core": "0.28.0",
    "@huggingface/transformers": "4.3.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openai/codex-sdk": "0.167.0",
    "dompurify": "3.4.17",
    "linkedom": "0.18.15",
    "marked": "18.1.3",
    "zod": "4.6.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inematds/time-de-bots.git"
  },
  "homepage": "https://inematds.github.io/time-de-bots/guia/",
  "bugs": {
    "url": "https://github.com/inematds/time-de-bots/issues"
  }
}
